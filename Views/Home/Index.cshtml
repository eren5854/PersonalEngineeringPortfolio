            <label><span>isim&gt;</span><input name="n" required autocomplete="name"></label>
            <label><span>eposta&gt;</span><input name="e" type="email" required autocomplete="email"></label>
            <label><span>mesaj&gt;</span><textarea name="m" rows="4" required></textarea></label>
            <button>./gonder.sh</button>
            <div id="out"></div>
        </form>
    </div>
</section>

