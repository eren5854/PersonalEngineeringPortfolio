        <button class="on" data-f="all">Tümü</button><button data-f="gomulu">Gömülü</button><button data-f="guc">
        Güç
    </button><button data-f="yazilim">Yazılım</button><button data-f="otomasyon">Otomasyon</button>
</div>
<div class="grid" id="grid"></div>
